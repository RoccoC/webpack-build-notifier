{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["airbnb-base", "airbnb-typescript/base"],
  "parserOptions": {
    "project": "./tsconfig.eslint.json",
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "ignorePatterns": ["dist", "tests/*.js"],
  "overrides": [
    {
      "files": ["*.ts"],
      "rules": {
        "max-len": [
          "error",
          {
            "code": 125
          }
        ]
      }
    }
  ],
  "rules": {
    "import/no-extraneous-dependencies": ["error", {"devDependencies": ["tests/*", "tsup.config.ts"]}]
  }
}
